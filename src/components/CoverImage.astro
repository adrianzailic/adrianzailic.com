---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  src: string;
  slug?: string;
  priority?: boolean;
}

const { title, src, slug, priority = false } = Astro.props;
const imageClass = `shadow-sm w-full ${slug ? 'hover:shadow-lg transition-shadow duration-200' : ''}`;
const loading = priority ? 'eager' : 'lazy';
---

<div class="sm:mx-0">
  {slug ? (
    <a href={`/posts/${slug}`} aria-label={title}>
      <Image
        src={src}
        alt={`Cover Image for ${title}`}
        width={1300}
        height={630}
        class={imageClass}
        loading={loading}
        format="webp"
        widths={[630, 1300, 2000]}
        sizes="(max-width: 630px) 630px, (max-width: 1300px) 1300px, 2000px"
        priority={priority}
      />
    </a>
  ) : (
    <Image
      src={src}
      alt={`Cover Image for ${title}`}
      width={1300}
      height={630}
      class={imageClass}
      loading={loading}
      format="webp"
      widths={[630, 1300, 2000]}
      sizes="(max-width: 630px) 630px, (max-width: 1300px) 1300px, 2000px"
      priority={priority}
    />
  )}
</div>
