---
import DateFormatter from './DateFormatter.astro';
import CoverImage from './CoverImage.astro';

interface Props {
  title: string;
  coverImage: string;
  date: string;
  excerpt: string;
  slug: string;
}

const { title, coverImage, date, excerpt, slug } = Astro.props;
---

<section>
  <div class="flex flex-col md:flex-row md:gap-x-16 lg:gap-x-8 mb-20 md:mb-28">
    <div class="flex flex-col justify-center order-2 md:order-1 md:w-1/2">
      <h3 class="mb-4 text-3xl lg:text-4xl leading-tight">
        <a href={`/posts/${slug}`} class="hover:underline">
          {title}
        </a>
      </h3>
      <div class="mb-4 md:mb-0 text-base">
        <DateFormatter dateString={date} />
      </div>
      <p class="text-base leading-relaxed mb-4">{excerpt}</p>
      <p class="text-base leading-relaxed mb-4">
        <a
          href={`/posts/${slug}`}
          class="hover:underline font-bold"
          aria-label={title}
        >
          Read more
        </a>
      </p>
    </div>
    <div class="mb-8 md:mb-0 order-1 md:order-2 md:w-1/2">
      <CoverImage title={title} src={coverImage} slug={slug} priority={true} />
    </div>
  </div>
</section>
