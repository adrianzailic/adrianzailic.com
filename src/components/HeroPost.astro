---
import Avatar from './Avatar.astro';
import DateFormatter from './DateFormatter.astro';
import CoverImage from './CoverImage.astro';
import type Author from '../lib/types';

interface Props {
  title: string;
  coverImage: string;
  date: string;
  excerpt: string;
  author: Author;
  slug: string;
}

const { title, coverImage, date, excerpt, author, slug } = Astro.props;
---

<section>
  <div class="mb-8 md:mb-16">
    <CoverImage title={title} src={coverImage} slug={slug} priority={true} />
  </div>
  <div class="md:grid md:grid-cols-2 md:gap-x-16 lg:gap-x-8 mb-20 md:mb-28">
    <div>
      <h3 class="mb-4 text-4xl lg:text-5xl leading-tight">
        <a href={`/posts/${slug}`} class="hover:underline">
          {title}
        </a>
      </h3>
      <div class="mb-4 md:mb-0 text-lg">
        <DateFormatter dateString={date} />
      </div>
    </div>
    <div>
      <p class="text-lg leading-relaxed mb-4">{excerpt}</p>
      <p class="text-lg leading-relaxed mb-4">
        <a
          href={`/posts/${slug}`}
          class="hover:underline font-bold"
          aria-label={title}
        >
          View full {title} article
        </a>
      </p>
      <Avatar name={author.name} picture={author.picture} />
    </div>
  </div>
</section>
