---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  sizes?: string;
  format?: 'webp' | 'avif' | 'jpeg' | 'png' | 'svg';
}

const {
  src,
  alt,
  width = 800,
  height = 600,
  class: className = '',
  loading = 'lazy',
  priority = false,
  sizes = '(max-width: 800px) 800px, 1200px',
  format = 'webp',
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  {format}
  widths={[width * 0.5, width, width * 1.5, width * 2]}
  {sizes}
  {priority}
/>
