---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Intro from '../components/Intro.astro';
import HeroPost from '../components/HeroPost.astro';
import MoreStories from '../components/MoreStories.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const heroPost = allPosts[0];
const morePosts = allPosts.slice(1);
---

<BaseLayout>
  <Container>
    <Intro />
    {heroPost && (
      <HeroPost
        title={heroPost.data.title}
        coverImage={heroPost.data.coverImage}
        date={heroPost.data.date}
        excerpt={heroPost.data.excerpt}
        author={heroPost.data.author}
        slug={heroPost.slug}
      />
    )}
    {morePosts.length > 0 && <MoreStories posts={morePosts.map(p => ({ ...p.data, slug: p.slug }))} />}
  </Container>
</BaseLayout>
